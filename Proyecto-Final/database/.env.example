# Conexion a Neon (compartida del equipo).
# El owner del modulo (Brian) comparte la URL real via canal privado (WhatsApp/DM).
# NO commitear el .env real (esta en .gitignore).
#
# Usar SIEMPRE el endpoint POOLED (incluye "-pooler" en el host) para Spring Boot.
# Para correr Flyway CLI manual: usar el endpoint DIRECT (sin "-pooler"), pgbouncer no soporta migraciones.

# Pooled endpoint (lo que usa el backend en runtime)
DATABASE_URL=postgresql://pqrs_app:REEMPLAZAR@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct endpoint (solo para Flyway CLI - migraciones)
DATABASE_URL_DIRECT=postgresql://neondb_owner:REEMPLAZAR@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
